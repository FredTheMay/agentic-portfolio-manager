# Copy to .env and fill in:   cp .env.example .env
#
# ⚠️  PUT REAL KEYS IN .env, NEVER IN THIS FILE.
#     .env is gitignored. THIS file is tracked by git and will be pushed.
#     tests/test_no_secrets.py fails the build if a value appears here.
#
# Every one of these is OPTIONAL — with none set, the full pipeline, backtest,
# dashboard and test suite all run offline against synthetic data.

# --- Required before any LIVE SEC EDGAR call -------------------------------
# SEC's fair-access policy requires a real name and email in the User-Agent.
# Requests without one are throttled or blocked. No account or key needed.
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=

# --- Macro data (free, instant) -------------------------------------------
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Market data + paper trading (free, instant) --------------------------
# https://alpaca.markets/  — create a PAPER account. There is no live endpoint
# in this codebase and AlpacaPaperBroker refuses to construct against one.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- LLM (optional; defaults to NullProvider) ------------------------------
# Gemini: https://aistudio.google.com/apikey   (~1500 req/day, no card)
# Groq:   https://console.groq.com/keys        (fast, smaller daily ceiling)
# NOTE: Groq is an inference provider. Grok is xAI's paid model. Different
# companies, one letter apart.
GEMINI_API_KEY=
GROQ_API_KEY=

# null | gemini | groq | failover
LLM_PROVIDER=null

# simulated | simulated_spread | naive | grpc
EXECUTOR=simulated_spread
